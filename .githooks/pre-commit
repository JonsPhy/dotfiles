#!/usr/bin/env bash
# Block commits containing secrets. Installed by bootstrap.sh via
#   git config core.hooksPath .githooks
# Bypass in an emergency with: git commit --no-verify

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed - skipping secret scan." >&2
  echo "            brew install gitleaks" >&2
  exit 0
fi

# NOTE: must be `git diff --cached | gitleaks stdin`.
# On gitleaks 8.30 both `gitleaks protect --staged` and `gitleaks git --staged`
# exit 0 on a staged AWS key -- they scan commits, not the staged diff, so a
# hook built on them silently passes everything. Verified with a canary.
echo "pre-commit: scanning staged changes for secrets..."
if ! git diff --cached | gitleaks stdin --no-banner --redact --config .gitleaks.toml; then
  cat >&2 <<'MSG'

pre-commit: SECRETS DETECTED - commit aborted.

  * If real: remove the secret, then rotate it. It is already on disk and
    may be in your shell history.
  * If a false positive: add a path or regex to the [allowlist] in
    .gitleaks.toml, or append `# gitleaks:allow` to the offending line.
  * To bypass deliberately: git commit --no-verify

MSG
  exit 1
fi
echo "pre-commit: clean."

# Keep CHEATSHEET.md in step with the configs it is generated from. This is the
# cheap half of the KEYBINDINGS.md §8 guardrail: the expensive half diffs every
# binding against §4, but simply refusing to let the generated file go stale
# catches most of the drift for a two-line hook.
if git diff --cached --name-only | grep -qE '^(ghostty/config|aerospace/aerospace\.toml|karabiner/karabiner\.json|nvim/lua/|zen/|corne/layout\.vil|scripts/gen-cheatsheet\.py)'; then
  if ! python3 scripts/gen-cheatsheet.py --check >/dev/null 2>&1; then
    cat >&2 <<'MSG'

pre-commit: CHEATSHEET.md is stale - commit aborted.

  A config that feeds the cheatsheet changed but the cheatsheet was not
  regenerated. Run:

      python3 scripts/gen-cheatsheet.py && git add CHEATSHEET.md

  To bypass deliberately: git commit --no-verify

MSG
    exit 1
  fi
  echo "pre-commit: CHEATSHEET.md up to date."
fi
