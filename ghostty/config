# Ghostty — see `ghostty +show-config --default --docs` for every option.

# ── Appearance ───────────────────────────────────────────────────────────────
# Ghostty's theme names are the display names, not slugs: "Catppuccin Mocha",
# not catppuccin-mocha. `ghostty +list-themes` lists all 463.
theme = Catppuccin Mocha

# Exact family name from `ghostty +list-fonts` — "MesloLGS Nerd Font" alone
# does not match; the installed family is the Mono variant.
font-family = MesloLGS Nerd Font Mono
font-size = 14
font-thicken = true

# Neovim's colorschemes are all transparent = true, so the terminal background
# is what actually shows through.
background-opacity = 0.92
background-blur = 20

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = auto
window-save-state = always

# macOS native tabs rather than Ghostty's own
macos-titlebar-style = tabs

# `false`, and it matters on this machine. The layout here is German, where the
# whole programming-symbol set is Option-composed — { } are option+8/9, [ ] are
# option+5/6, \ is option+shift+7, | is option+7, @ is option+l, ~ is option+n.
# `true` makes Ghostty deliver those as Alt sequences instead of the composed
# character, so option+8 arrives as ESC 8: in Neovim the ESC drops out of insert
# mode and the digit lands as a count. Ghostty itself only defaults this to
# `true` for U.S. Standard and U.S. International layouts.
#
# Not `right` either: that only frees the left Option, and which Option key you
# reach for when typing a brace is a matter of habit, so it fixes the problem
# only half the time.
#
# Cost: Alt bindings whose Option sequence composes a printable character are
# lost — in practice just fzf's Alt-C (option+c is `ç` here). Ghostty still
# treats Option as Alt automatically whenever the sequence produces no
# printable character, so the rest keep working.
#
# (This paragraph used to note that the cmd+alt+arrow split bindings were
# unaffected. Those bindings are gone — see the keybindings section, where the
# whole Alt family is unbound per KEYBINDINGS.md §2.4.)
#
# NOTE: this is applied when a surface is created. Changing it needs a full
# Cmd+Q and relaunch — a config reload or a new tab is not enough.
macos-option-as-alt = false

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Shell ────────────────────────────────────────────────────────────────────
# Ghostty injects shell integration automatically for zsh; this enables the
# extra features (cursor shape, sudo prompt awareness, working-dir reporting).
shell-integration = zsh
shell-integration-features = cursor,sudo,title

scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false

# ── Keybindings ──────────────────────────────────────────────────────────────
# See KEYBINDINGS.md — this section implements §4.2 (App-chrome — Cmd).
#
# The one hard rule: Ghostty binds no ctrl+<letter> chord, ever. A terminal
# that binds ctrl+h consumes it, and the program running inside — Neovim, which
# owns ctrl+hjkl for window navigation — never receives the keystroke. Since
# the splits actually navigated all day are Neovim's, Ghostty's own splits live
# on Cmd+Shift instead (§3.2, §2.6). That costs little: structurally a split is
# the same kind of object as a tab, and tabs were already Cmd.
#
# The resulting mnemonic, one scope per modifier:
#   Cmd+Shift + hjkl  move within the window (splits)
#   Ctrl + Tab        move between tabs
#   Hyper + hjkl      move between OS windows  (Karabiner/AeroSpace, not here)
#   Ctrl + hjkl       move within the program — reaches Neovim, never bound here
#
# Direction is always hjkl, never arrows (§3.2). The old cmd+alt+arrow split
# bindings were wrong twice over: arrows, and Option — which composes symbols
# on a German layout and so is unavailable as a modifier (§2.4).
#
# Every keybind gets a description line above it. This is not decoration: the
# planned Hyper+i help panel (§9.5) is generated by parsing this file, so an
# undescribed binding is an invisible one. Ghostty rejects a trailing `#` on a
# keybind line (error.InvalidFormat — the comment is parsed as part of the
# action), which is why the descriptions sit above rather than beside.
#
# The description is the SINGLE comment line immediately above the keybind.
# Longer rationale goes above that line, not into it — a wrapped description
# would make the generator quote its second half. scripts/gen-cheatsheet.py
# reads this file on exactly that convention.

# Splits — create, zoom, close
# split the focused surface to the right
keybind = cmd+d=new_split:right
# split the focused surface downwards
keybind = cmd+shift+d=new_split:down
# zoom the focused split to fill the window, or restore it
keybind = cmd+enter=toggle_split_zoom
# close the focused split — or the tab, when it is the only split
keybind = cmd+w=close_surface

# Splits — focus. Cmd+Shift+hjkl, the same letters Neovim uses on Ctrl one
# scope in.
#
# NOT plain Cmd+hjkl, and this is deliberate (§2.6): cmd+h is the macOS "Hide
# Application" menu item, and AppKit dispatches menu key equivalents before
# Ghostty ever sees the event. Binding it would hide the window instead of
# moving focus left — a failure that strikes precisely when you reach for it by
# reflex. Zen's own shortcut file marks cmd+h `internal`, i.e. not Zen's to own
# either, so this is not a Ghostty quirk. Shifting the whole row keeps the
# convention intact rather than leaving a hole in it.
# focus the split to the left
keybind = cmd+shift+h=goto_split:left
# focus the split below
keybind = cmd+shift+j=goto_split:down
# focus the split above
keybind = cmd+shift+k=goto_split:up
# focus the split to the right
keybind = cmd+shift+l=goto_split:right

# Splits — resize and balance. Cmd+Ctrl+hjkl, the third and last direction row.
# Ghostty ships resize on cmd+ctrl+ARROWS, which §3.2 rules out; these override
# it so that every direction in the whole config is hjkl and none is arrows.
#
# The amount is in PIXELS, not columns. Ghostty's own default is 10, which at
# font-size 14 is barely one character width — it fires, but looks like nothing
# happened. 50 is roughly six columns: visible in one press, still fine to hold.
# These are no-ops when the window has only one pane; there must be a split to
# resize.
# widen the split to the left
keybind = cmd+ctrl+h=resize_split:left,50
# grow the split downwards
keybind = cmd+ctrl+j=resize_split:down,50
# grow the split upwards
keybind = cmd+ctrl+k=resize_split:up,50
# widen the split to the right
keybind = cmd+ctrl+l=resize_split:right,50
# reset all splits to equal size (stock is cmd+ctrl+=, which is punctuation)
keybind = cmd+ctrl+0=equalize_splits

# Tabs and windows
# new window
keybind = cmd+n=new_window
# new tab
keybind = cmd+t=new_tab
# next tab
keybind = ctrl+tab=next_tab
# previous tab
keybind = ctrl+shift+tab=previous_tab
# Two conventions rejected before landing here. The macOS one is cmd+shift+[
# and cmd+shift+]: on the German layout those brackets are option+5 and
# option+6, so the chord is untypeable (§2.3) and Option-based (§2.4). Arrows
# are out per §3.2. Cmd+Shift+h/l would have been the natural replacement, but
# the whole Cmd+Shift+hjkl row is spent on splits above — §2.6 pushed it there
# and something had to give. Ctrl+Tab is the browser convention and costs
# nothing: the no-Ctrl rule at the top of this section is about ctrl+<letter>,
# which has to reach the TUI inside. Tab is not a letter, and nothing here
# binds it.

# Tab digits.
# go to tab 1
keybind = cmd+1=goto_tab:1
# go to tab 2
keybind = cmd+2=goto_tab:2
# go to tab 3
keybind = cmd+3=goto_tab:3
# go to tab 4
keybind = cmd+4=goto_tab:4
# go to tab 5
keybind = cmd+5=goto_tab:5
# go to tab 6
keybind = cmd+6=goto_tab:6
# go to tab 7
keybind = cmd+7=goto_tab:7
# go to tab 8
keybind = cmd+8=goto_tab:8
# Zen, Safari and Chrome all bind cmd+9 to the last tab rather than the ninth;
# matching the platform beats literal consistency with cmd+1..8 (§4.2).
# go to the last tab
keybind = cmd+9=last_tab

# §4.2 "find in page/buffer". Ghostty ships this on cmd+f already; stated
# explicitly so the §9.5 generator can see it.
# search the scrollback buffer
keybind = cmd+f=start_search

# Font size. These use punctuation, which §2.3 forbids for bindings we control
# — kept as an acknowledged exception: font size is not a verb in the §3.1
# alphabet and these chords are macOS-universal muscle memory, not part of the
# convention. Flagged for a ruling rather than silently changed.
# increase font size by one point
keybind = cmd+plus=increase_font_size:1
# decrease font size by one point
keybind = cmd+minus=decrease_font_size:1
# reset font size to the configured default
keybind = cmd+zero=reset_font_size

# reload this config file in place
keybind = cmd+shift+r=reload_config
# ── Unbinding Ghostty's own defaults ─────────────────────────────────────────
# Deleting a keybind line does not disable the chord — Ghostty's stock defaults
# stay live underneath, and they violate the spec in ways the §8 guardrail grep
# would never catch, because that grep reads this file rather than Ghostty's
# built-in set. These are the ones that matter:
#
# cmd+alt+arrows were the old split-focus bindings. Arrows break §3.2 and Option
# breaks §2.4, and unlike the bracket chords below they remain fully typeable on
# a German layout — so they are the one group that would actually still fire.
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind

# cmd+shift+[ / ] (prev/next tab) and cmd+[ / ] (prev/next split) are the exact
# chords §4.2 rejects. On a German host they are Option-composed and therefore
# untypeable, so they are harmless *today* — but §2.5 says the layout follows
# the keyboard, and on a US keyboard they would come alive and shadow the
# convention. Unbound now so that switch stays uneventful.
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind

# Stock resize-on-arrows, superseded by the cmd+ctrl+hjkl row above. Left bound
# they would be a second way to do the same thing on a different alphabet —
# exactly the fragmentation this convention exists to remove (§1).
keybind = cmd+ctrl+left=unbind
keybind = cmd+ctrl+right=unbind
keybind = cmd+ctrl+up=unbind
keybind = cmd+ctrl+down=unbind
