# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Raycast ships compiled extension bundles (~166 MB). They are build artifacts,
# reinstalled by Raycast itself, and they are the only source of gitleaks
# findings in this repo (Raycast's own Asana/Linear/Slack OAuth client IDs
# baked into every install). Keep the scripts and AI presets, drop the bundles.
raycast/extensions/

# Secrets — never commit these
*.pem
*.key
*_rsa
*_ed25519
.env
.env.*
**/secrets.*
**/credentials.json
.claude/settings.local.json

# Yazi flavors and plugins are fetched packages, not config: `ya pkg` clones
# them into the config dir, and 664 KB of the catppuccin flavor is a preview
# screenshot. yazi/package.toml is the lockfile (it pins rev + hash), so it is
# tracked and `ya pkg install` restores these. Same split as nvim: the pins are
# committed, the fetched content is not.
yazi/flavors/
yazi/plugins/

# Editor / tooling state
nvim/lazy-lock.json.bak
**/.netrwhist
**/*.swp
**/node_modules/

# Shell history should never be tracked
.zsh_history
.zcompdump*
